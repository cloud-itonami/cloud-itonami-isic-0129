{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep, all
 ;; .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives in
 ;; the kotoba-lang org of this workspace. This repo is standalone
 ;; (forkable outside the workspace); the :local/root path only resolves
 ;; inside the monorepo checkout -- a standalone fork should override it
 ;; with a git coordinate.
 :deps {
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.coll"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "0ea3c03d6bb1ff89808e1fb57be897b902a3513d"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.langgraph"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}
         io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.langgraph"}}}
  :run {:main-opts ["-m" "perennial.sim"]}
  ;; kbb -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html through the real actor stack
  ;; (flagship checklist item 2).
  :render-html {:main-opts ["-m" "perennial.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
